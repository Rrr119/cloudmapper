{
  "SecurityGroups": [
    {
      "GroupId": "sg-shop-web",
      "GroupName": "shop-web",
      "IpPermissions": [
        {
          "FromPort": 443,
          "IpProtocol": "tcp",
          "IpRanges": [
            {
              "CidrIp": "0.0.0.0/0"
            }
          ],
          "ToPort": 443
        }
      ]
    },
    {
      "GroupId": "sg-shop-bastion",
      "GroupName": "shop-bastion",
      "IpPermissions": [
        {
          "FromPort": 22,
          "IpProtocol": "tcp",
          "IpRanges": [
            {
              "CidrIp": "0.0.0.0/0"
            }
          ],
          "ToPort": 22
        }
      ]
    },
    {
      "GroupId": "sg-shop-app",
      "GroupName": "shop-app",
      "IpPermissions": [
        {
          "FromPort": 8080,
          "IpProtocol": "tcp",
          "ToPort": 8080,
          "UserIdGroupPairs": [
            {
              "GroupId": "sg-shop-web"
            }
          ]
        },
        {
          "FromPort": 22,
          "IpProtocol": "tcp",
          "ToPort": 22,
          "UserIdGroupPairs": [
            {
              "GroupId": "sg-shop-bastion"
            }
          ]
        }
      ]
    },
    {
      "GroupId": "sg-shop-db",
      "GroupName": "shop-db",
      "IpPermissions": [
        {
          "FromPort": 5432,
          "IpProtocol": "tcp",
          "ToPort": 5432,
          "UserIdGroupPairs": [
            {
              "GroupId": "sg-shop-app"
            }
          ]
        }
      ]
    }
  ]
}
