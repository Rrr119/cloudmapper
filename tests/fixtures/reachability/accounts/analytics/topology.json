            {
              "GroupId": "sg-an-jump"
            }
          ]
        },
        {
          "FromPort": 5439,
          "IpProtocol": "tcp",
          "IpRanges": [
            {
              "CidrIp": "10.10.0.0/16"
            }
          ],
          "ToPort": 5439
        }
      ]
    },
    {
      "GroupId": "sg-an-locked",
      "GroupName": "analytics-locked-db",
      "IpPermissions": [
        {
          "FromPort": 5432,
          "IpProtocol": "tcp",
          "ToPort": 5432,
          "UserIdGroupPairs": [
