{
  "account_id": "333333333333",
  "name": "partner",
  "narrative": [
    "The internet-facing partner ELB accepts 443 from 0.0.0.0/0.",
    "The API instances accept 443 from the ELB group and can reach the Elasticsearch domain on 443.",
    "A publicly accessible RDS has 3306 open to 0.0.0.0/0: direct internet path.",
    "A private-only EC2 has 80 open to 0.0.0.0/0 at the SG layer but no public IP, so AWS routing makes it unreachable from the internet; it must not be reported as an entry point."
  ],
  "resources": [
    {
      "id": "elb-partner",
      "internet_reachable": true,
      "name": "partner-elb",
      "sg_ids": [
        "sg-p-ELB"
      ],
      "type": "elbv2"
    },
    {
      "id": "api",
      "name": "partner-api",
      "private_ips": [
        "10.3.0.10"
      ],
      "sg_ids": [
        "sg-p-api"
      ],
      "type": "ec2"
    },
    {
      "id": "es-partner",
      "name": "partner-es",
      "private_ips": [
        "10.3.2.20"
      ],
      "sg_ids": [
        "sg-p-es"
      ],
      "type": "elasticsearch"
    },
    {
      "id": "rds-leak",
      "internet_reachable": true,
      "name": "partner-leaked-rds",
      "sg_ids": [
        "sg-p-rdsopen"
      ],
      "type": "rds"
    },
    {
      "id": "hidden",
      "internet_reachable": false,
      "name": "partner-private-only-web",
      "private_ips": [
        "10.3.9.9"
      ],
      "sg_ids": [
        "sg-p-hiddenweb"
      ],
      "type": "ec2"
    }
  ],
  "security_groups": [
    {
      "GroupId": "sg-p-ELB",
      "GroupName": "partner-elb",
      "IpPermissions": [
        {
          "FromPort": 443,
          "IpProtocol": "tcp",
          "IpRanges": [
            {
              "CidrIp": "0.0.0.0/0"
            }
          ],
          "ToPort": 443
        }
      ]
    },
    {
      "GroupId": "sg-p-api",
      "GroupName": "partner-api",
      "IpPermissions": [
        {
          "FromPort": 443,
          "IpProtocol": "tcp",
          "ToPort": 443,
          "UserIdGroupPairs": [
            {
              "GroupId": "sg-p-ELB"
            }
          ]
        }
      ]
    },
    {
      "GroupId": "sg-p-es",
      "GroupName": "partner-es",
      "IpPermissions": [
        {
          "FromPort": 443,
          "IpProtocol": "tcp",
          "ToPort": 443,
          "UserIdGroupPairs": [
            {
              "GroupId": "sg-p-api"
            }
          ]
        }
      ]
    },
    {
      "GroupId": "sg-p-rdsopen",
      "GroupName": "partner-rds-open",
      "IpPermissions": [
        {
          "FromPort": 3306,
          "IpProtocol": "tcp",
          "IpRanges": [
            {
              "CidrIp": "0.0.0.0/0"
            }
          ],
          "ToPort": 3306
        }
      ]
    },
    {
      "GroupId": "sg-p-hiddenweb",
      "GroupName": "partner-hidden-web",
      "IpPermissions": [
        {
          "FromPort": 80,
          "IpProtocol": "tcp",
          "IpRanges": [
            {
              "CidrIp": "0.0.0.0/0"
            }
          ],
          "ToPort": 80
        }
      ]
    }
  ],
  "title": "Partner DMZ (internet-facing ELB and a leaked database)"
}
